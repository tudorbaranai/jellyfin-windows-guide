# OS junk, editor state and AI tool files. Good as a global ignore too:
#   git config --global core.excludesFile ~/.gitignore_global

# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes
.AppleDouble

# Windows
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# Editors
.idea/
*.iml
.vs/
*.suo
*.user
*.code-workspace
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json

# AI assistants: local only
.claude/settings.local.json
.claude/sessions/
.cursor/
.codex/
CLAUDE.md
AGENTS.md
NOTES.md

# Recordings, models, archives
*.wav
*.mp3
*.m4a
*.flac
*.ogg
*.mp4
*.mov
*.gguf
*.safetensors
*.pt
*.pth
*.onnx
*.ppn
*.rhn
*.zip
*.7z
*.vdi
*.vbox

# This repo documents a media server: never commit media, Jellyfin data or local config
*.mkv
*.m4v
*.avi
*.srt
ProgramData/
Jellyfin/
*.db
*.log
.env
reports/
